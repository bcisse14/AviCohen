# Clé API Resend (offre gratuite : 100 e-mails/jour).
# https://resend.com/api-keys
# Copier ce fichier dans .env.local, jamais versionner la vraie clé.
# En production, définir ces variables dans les secrets de l'hébergeur.
# Ne jamais utiliser de préfixe NEXT_PUBLIC_ pour la clé.
RESEND_API_KEY=

# Adresse qui reçoit les messages du formulaire de contact.
# Avant activation du CMS uniquement. Une fois DATABASE_URL définie,
# le destinataire se règle dans /admin > Réglages du site.
CONTACT_EMAIL_TO=docteurcohena@gmail.com

# Adresse d'expédition des e-mails envoyés via Resend.
# Tant que le domaine du cabinet n'est pas vérifié sur Resend, laisser
# "onboarding@resend.dev".
# En mode test, le destinataire doit être l'adresse du compte Resend.
# Pour les autres destinataires, utiliser une adresse d'un domaine vérifié.
CONTACT_EMAIL_FROM=onboarding@resend.dev

# Mini CMS : secrets serveur, sans préfixe NEXT_PUBLIC_.
# PostgreSQL Neon : URL fournie par l'intégration Neon de Vercel.
DATABASE_URL=

# Compte administrateur unique. Ne jamais stocker le mot de passe en clair.
# Générer l'empreinte scrypt et la clé avec : npm run cms:password
# CMS_ADMIN_USERNAME est prioritaire ; CMS_ADMIN_EMAIL reste compatible
# avec les installations existantes.
CMS_ADMIN_USERNAME=avicohen
CMS_ADMIN_EMAIL=
CMS_ADMIN_PASSWORD_HASH=
CMS_SESSION_SECRET=

# Vercel Blob : créer un store PUBLIC et connecter le projet.
# Les imports sont désactivés tant que cette clé n'est pas configurée.
BLOB_READ_WRITE_TOKEN=
